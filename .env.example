# RoxyAPI key (required) - get one at https://roxyapi.com/pricing
ROXYAPI_KEY=your_roxyapi_key_here

# RoxyAPI MCP base URL (optional - defaults to https://roxyapi.com/mcp)
# ROXYAPI_MCP_URL=https://roxyapi.com/mcp

# Which RoxyAPI products to connect (optional - defaults to all 14, 200+ tools).
# Fewer tools means faster and more accurate tool selection, so trim this to the
# domains your product actually needs. Keep `location` whenever a chart product is
# enabled: it resolves "born in Mumbai" to coordinates and a timezone before the
# chart call. Slugs: astrology, vedic-astrology, forecast, human-design,
# chinese-astrology, feng-shui, mesoamerican-astrology, vastu, numerology, kabbalah,
# tarot, biorhythm, ayurveda, iching, crystals, dreams, angel-numbers, location
# ROXYAPI_PRODUCTS=tarot,astrology,location

# LLM Provider - choose one: gemini (default), anthropic, openai
LLM_PROVIDER=gemini

# Google Gemini (default - cheapest, has free tier)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Anthropic Claude (best quality interpretations)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT (most popular)
# OPENAI_API_KEY=your_openai_api_key_here
